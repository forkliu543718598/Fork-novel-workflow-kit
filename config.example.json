{
  "_说明": "复制本文件为 config.json 并改成你自己的信息。config.json 已在 .gitignore 中，不会被提交。",

  "作品": {
    "书名": "（你的书名）",
    "题材": "（如：都市 / 系统 / 电竞）",
    "目标总字数": 0,
    "计划集数": 0,
    "一句话卖点": "（用一句话说清爽点）"
  },

  "角色选型": {
    "主Agent": {
      "当前": "WorkBuddy Hy4-flash",
      "历史": ["Codex"],
      "备注": "按手头免费额度替换；注意免费期时效"
    },
    "策划": {
      "当前": "Gemini",
      "可选": ["ChatGPT", "Claude", "人工"]
    },
    "写稿": {
      "当前": "DeepSeek / WorkBuddy 自带 4.1-flash",
      "可选": ["ChatGPT", "人工"],
      "备注": "前期追求低成本可用便宜模型"
    },
    "审核": {
      "当前": "Gemini",
      "可选": ["ChatGPT", "审稿专家", "人工交叉审"],
      "硬规则": "审核角色不得与写稿角色相同"
    },
    "知识库": {
      "当前": "Obsidian",
      "可选": ["本地 Markdown 库", "腾讯文档"]
    },
    "发布Agent": {
      "当前": "带 computer use 的 Agent",
      "必需能力": ["打开网页", "填写表单", "点击按钮", "读取页面文本"]
    }
  },

  "路径": {
    "项目根目录": "（你的本地项目根目录，如 D:/novel/mybook）",
    "Obsidian库目录": "（你的 Obsidian vault 绝对路径）",
    "章节目录": "（相对项目根目录，如 chapters/）",
    "审核记录目录": "（如 review/）",
    "发布记录目录": "（如 publish/）"
  },

  "平台": {
    "名称": "（如：番茄小说作家后台）",
    "作家后台地址": "（如 https://fanqienovel.com/main/writer/）",
    "作品ID": "（你的书号，留空则由发布Agent自行核对）",
    "账号": "（你的账号名）"
  },

  "发布约束": {
    "标题最少字数": 5,
    "正文最少字数": 1000,
    "标题不得重复": true,
    "确认提交每章点击次数": 1,
    "提交后必须回读平台状态": true,
    "禁止代办": ["登录", "验证码", "实名", "签约", "完结申请"]
  }
}
